// Обезличивание данных для MCP_HTTPService (0.5.0).
// Вызывается HTTP-сервисом MCPService; доступен и серверному коду базы — так его можно
// проверить на настоящих данных без веб-публикации (например, через MCP Toolkit execute_code):
//   MCP_Обезличивание.ВыполнитьЗапрос("ВЫБРАТЬ ПЕРВЫЕ 5 Наименование, ИИН ИЗ Справочник.Контрагенты")

Функция РазобратьJSON(СтрокаJSON)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();
    Возврат Результат;
КонецФункции

Функция СформироватьJSON(Значение)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Значение);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ЗначениеДляJSON(Значение)
    Если Значение = Неопределено ИЛИ Значение = NULL Тогда
        Возврат "";
    ИначеЕсли ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат Значение;
    Иначе
        Возврат Строка(Значение);
    КонецЕсли;
КонецФункции

// Запрос с обезличиванием — то же, что отдаёт /query: {columns, rows, total, truncated, anonymized}
// или {error}. Метки в тексте и параметрах восстанавливаются, значения результата — метками.
Функция ВыполнитьЗапрос(Знач ТекстЗапроса, Параметры = Неопределено, Лимит = 100) Экспорт
    К = НовыйКонтекстОбезличивания();
    ТекстЗапроса = ВосстановитьМетки(К, ТекстЗапроса, Истина);
    Попытка
        Запрос1С = Новый Запрос(ТекстЗапроса);
        Если ТипЗнч(Параметры) = Тип("Структура") Тогда
            Для Каждого КлючИЗначение Из Параметры Цикл
                Запрос1С.УстановитьПараметр(КлючИЗначение.Ключ, ВосстановитьПараметр(К, КлючИЗначение.Значение));
            КонецЦикла;
        КонецЕсли;
        РезультатЗапроса = Запрос1С.Выполнить();
    Исключение
        Возврат Новый Структура("error", ОбезличитьТекстОшибки(К, ОписаниеОшибки()));
    КонецПопытки;
    Категории = ?(К.Включено, КатегорииКолонок(К, ТекстЗапроса, РезультатЗапроса), Новый Соответствие);

    Колонки = Новый Массив;
    Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
        Колонки.Добавить(Колонка.Имя);
    КонецЦикла;
    Выборка = РезультатЗапроса.Выбрать();
    Строки = Новый Массив;
    Счетчик = 0;
    Усечено = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Счетчик >= Лимит Тогда
            Усечено = Истина;
            Прервать;
        КонецЕсли;
        Строка = Новый Массив;
        Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
            Строка.Добавить(ОбезличитьЗначение(К, Выборка[Колонка.Имя], Категории.Получить(Колонка.Имя)));
        КонецЦикла;
        Строки.Добавить(Строка);
        Счетчик = Счетчик + 1;
    КонецЦикла;
    СохранитьМетки(К);

    Результат = Новый Структура;
    Результат.Вставить("columns", Колонки);
    Результат.Вставить("rows", Строки);
    Результат.Вставить("total", Счетчик);
    Результат.Вставить("truncated", Усечено);
    Результат.Вставить("anonymized", К.Включено);
    Возврат Результат;
КонецФункции

// Метки в тексте → настоящие значения: то, что делает /detokenize для моста.
Функция Расшифровать(Текст) Экспорт
    Возврат ВосстановитьМетки(НовыйКонтекстОбезличивания(), Текст);
КонецФункции

// Правила целиком (JSON). Пустая строка — вернуть правила по умолчанию.
Процедура УстановитьПравила(ТекстПравил, Ревизия = "") Экспорт
    ЗаписатьНастройкуОбезличивания("Правила", ТекстПравил);
    ЗаписатьНастройкуОбезличивания("РевизияПравил", Ревизия);
КонецПроцедуры

// ============================================================
// Обезличивание (0.5.0)
// ============================================================
// Конфиденциальные значения (ИИН/БИН, телефоны, e-mail, адреса, счета, номера
// документов, имена людей, наименования организаций…) уходят из базы МЕТКАМИ
// вида [ФЛ-3F9A2C]. Одно значение в этой базе — всегда одна метка, поэтому по
// меткам можно группировать, сравнивать и передавать их обратно в запрос:
// перед выполнением метки в тексте и параметрах запроса заменяются настоящими
// значениями.
//
// Таблица «метка → значение» хранится в хранилище общих настроек этой базы
// (объект MCP_Обезличивание, ключи Метки_0…Метки_F) — наружу не уходит.
// Расшифровать текст можно только методом /detokenize с ключом моста; ключ
// задаёт мост при первом вызове /anonymization, в базе лежит только его хеш.
// Правила (что считать конфиденциальным) мост присылает тем же методом; пока их
// нет — действуют правила по умолчанию (ТекстПравилПоУмолчанию).

Функция ТекстПравилПоУмолчанию() Экспорт
    // Пары «подстрока → категория»: tables — имя объекта метаданных или реквизита-ссылки
    // (контекст поля), fields — имя поля или колонки («=Имя» — точное совпадение).
    // keep — поля, которые не трогаются никогда; patterns — что искать в любом тексте.
    Возврат
    "{""enabled"": true,
    |""categories"": [""ФЛ"", ""ОРГ"", ""ИИН"", ""ТЕЛ"", ""EMAIL"", ""АДР"", ""СЧЕТ"", ""КАРТА"", ""ДОК"", ""ДОГ"", ""УДЛ"", ""КОД""],
    |""tables"": [[""Договор"", ""ДОГ""], [""БанковскиеСчета"", ""СЧЕТ""], [""БанковскийСчет"", ""СЧЕТ""],
    |  [""ЛицевыеСчета"", ""КОД""], [""ЛицевойСчет"", ""КОД""],
    |  [""ФизическиеЛица"", ""ФЛ""], [""ФизическоеЛицо"", ""ФЛ""], [""ФизЛиц"", ""ФЛ""], [""Сотрудник"", ""ФЛ""],
    |  [""Пользовател"", ""ФЛ""], [""КонтактныеЛица"", ""ФЛ""], [""КонтактноеЛицо"", ""ФЛ""], [""Ответственн"", ""ФЛ""],
    |  [""Руководител"", ""ФЛ""], [""Бухгалтер"", ""ФЛ""], [""Кассир"", ""ФЛ""], [""Абонент"", ""ФЛ""],
    |  [""Собственник"", ""ФЛ""], [""Жилец"", ""ФЛ""], [""Житель"", ""ФЛ""], [""Подотчет"", ""ФЛ""],
    |  [""Контрагент"", ""ОРГ""], [""Организаци"", ""ОРГ""], [""Партнер"", ""ОРГ""], [""Клиент"", ""ОРГ""],
    |  [""Покупател"", ""ОРГ""], [""Поставщик"", ""ОРГ""], [""Арендатор"", ""ОРГ""], [""Получател"", ""ОРГ""],
    |  [""Плательщик"", ""ОРГ""], [""Документ."", ""ДОК""]],
    |""fields"": [[""ИИН"", ""ИИН""], [""БИН"", ""ИИН""], [""ИНН"", ""ИИН""], [""РНН"", ""ИИН""],
    |  [""ИдентификационныйНомер"", ""ИИН""], [""ОКПО"", ""КОД""],
    |  [""Телефон"", ""ТЕЛ""], [""Факс"", ""ТЕЛ""], [""Мобильн"", ""ТЕЛ""],
    |  [""Email"", ""EMAIL""], [""ЭлектроннаяПочта"", ""EMAIL""], [""ЭлПочта"", ""EMAIL""], [""E_mail"", ""EMAIL""],
    |  [""Адрес"", ""АДР""], [""Фамилия"", ""ФЛ""], [""Отчество"", ""ФЛ""], [""ФИО"", ""ФЛ""], [""Инициалы"", ""ФЛ""],
    |  [""=Имя"", ""ФЛ""], [""IBAN"", ""СЧЕТ""], [""НомерСчета"", ""СЧЕТ""], [""ИИК"", ""СЧЕТ""],
    |  [""РасчетныйСчет"", ""СЧЕТ""], [""НомерКарт"", ""КАРТА""], [""Паспорт"", ""УДЛ""], [""Удостоверени"", ""УДЛ""],
    |  [""ДокументУдостоверяющ"", ""УДЛ""], [""СерияДокумента"", ""УДЛ""], [""НомерДокумента"", ""УДЛ""],
    |  [""КемВыдан"", ""УДЛ""], [""=Номер"", ""ДОК""], [""НомерВходящ"", ""ДОК""], [""ВходящийНомер"", ""ДОК""],
    |  [""ИдентификационныйКод"", ""ИИН""], [""=СИК"", ""СЧЕТ""], [""Свидетельств"", ""КОД""],
    |  [""НалоговойРегистрации"", ""КОД""], [""КодВСтранеРегистрации"", ""КОД""], [""НомерДоговора"", ""ДОГ""],
    |  [""НаименованиеИностр"", ""ОРГ""]],
    |""tables_all"": [[""КонтактнаяИнформация"", ""АДР""], [""КонтактнойИнформации"", ""АДР""]],
    |""keep"": [""НомерСтроки""],
    |""patterns"": [""EMAIL"", ""ИИН"", ""ТЕЛ"", ""КАРТА"", ""СЧЕТ""]}";
КонецФункции

// Поля-«наименования»: их категория берётся из контекста (чьё это наименование).
Функция ЭтоПолеНаименования(ИмяПоля)
    Имя = НРег(ИмяПоля);
    Возврат Имя = "наименование" ИЛИ Имя = "наименованиеполное" ИЛИ Имя = "полноенаименование"
        ИЛИ Имя = "код" ИЛИ Имя = "description" ИЛИ Имя = "code" ИЛИ Имя = "представление"
        ИЛИ Имя = "presentation";
КонецФункции

Функция ПрочитатьНастройкуОбезличивания(Ключ) Экспорт
    Возврат ХранилищеОбщихНастроек.Загрузить("MCP_Обезличивание", Ключ);
КонецФункции

Процедура ЗаписатьНастройкуОбезличивания(Ключ, Значение) Экспорт
    ХранилищеОбщихНастроек.Сохранить("MCP_Обезличивание", Ключ, Значение);
КонецПроцедуры

Функция ХешСтроки(Текст) Экспорт
    Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш.Добавить(Текст);
    Возврат ВРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Функция ТекущиеПравила() Экспорт
    ПоУмолчанию = РазобратьJSON(ТекстПравилПоУмолчанию());
    Текст = ПрочитатьНастройкуОбезличивания("Правила");
    Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Текст) Тогда
        Возврат ПоУмолчанию;
    КонецЕсли;
    Попытка
        Правила = РазобратьJSON(Текст);
    Исключение
        Возврат ПоУмолчанию;
    КонецПопытки;
    Если ТипЗнч(Правила) <> Тип("Структура") Тогда
        Возврат ПоУмолчанию;
    КонецЕсли;
    Для Каждого КЗ Из ПоУмолчанию Цикл
        Если НЕ Правила.Свойство(КЗ.Ключ) Тогда
            Правила.Вставить(КЗ.Ключ, КЗ.Значение);
        КонецЕсли;
    КонецЦикла;
    Возврат Правила;
КонецФункции

Функция НовыйКонтекстОбезличивания() Экспорт
    К = Новый Структура;
    Правила = ТекущиеПравила();
    К.Вставить("Правила", Правила);
    К.Вставить("Включено", Правила.enabled = Истина);
    Категории = Новый Соответствие;
    Для Каждого Кат Из Правила.categories Цикл
        Категории.Вставить(Кат, Истина);
    КонецЦикла;
    К.Вставить("Категории", Категории);
    Шаблоны = Новый Соответствие;
    Для Каждого Кат Из Правила.patterns Цикл
        Шаблоны.Вставить(Кат, Истина);
    КонецЦикла;
    К.Вставить("Шаблоны", Шаблоны);
    Соль = ПрочитатьНастройкуОбезличивания("Соль");
    Если ТипЗнч(Соль) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Соль) Тогда
        Соль = Строка(Новый УникальныйИдентификатор);
        ЗаписатьНастройкуОбезличивания("Соль", Соль);
    КонецЕсли;
    К.Вставить("Соль", Соль);
    К.Вставить("Шарды", Новый Соответствие);        // символ → Соответствие(метка → Структура(v, r))
    К.Вставить("Новые", Новый Соответствие);        // символ → Соответствие новых меток этого вызова
    К.Вставить("Кэш", Новый Соответствие);          // «категория|значение» → метка
    К.Вставить("Восстановленные", Новый Соответствие); // значение → метка: для текста ошибок
    Возврат К;
КонецФункции

Функция КатегорияВключена(К, Кат)
    Возврат ЗначениеЗаполнено(Кат) И К.Категории.Получить(Кат) = Истина;
КонецФункции

Функция ПодходитПравило(Имя, Образец)
    Если Лев(Образец, 1) = "=" Тогда
        Возврат НРег(Имя) = НРег(Сред(Образец, 2));
    КонецЕсли;
    Возврат СтрНайти(НРег(Имя), НРег(Образец)) > 0;
КонецФункции

Функция КатегорияПоПравилам(К, СписокПравил, Имя)
    Для Каждого Пара Из СписокПравил Цикл
        Если ТипЗнч(Пара) = Тип("Массив") И Пара.Количество() = 2 И ПодходитПравило(Имя, Пара[0]) Тогда
            Возврат ?(КатегорияВключена(К, Пара[1]), Пара[1], "");
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция ПолеНеТрогать(К, Имя)
    Для Каждого Образец Из К.Правила.keep Цикл
        Если ПодходитПравило(Имя, Образец) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция ШардМеток(К, Символ)
    Шард = К.Шарды.Получить(Символ);
    Если Шард = Неопределено Тогда
        Шард = ПрочитатьНастройкуОбезличивания("Метки_" + Символ);
        Если ТипЗнч(Шард) <> Тип("Соответствие") Тогда
            Шард = Новый Соответствие;
        КонецЕсли;
        К.Шарды.Вставить(Символ, Шард);
    КонецЕсли;
    Возврат Шард;
КонецФункции

// Метка значения. Значение и ссылка (если это ссылка) запоминаются в таблице меток.
Функция Метка(К, Кат, Значение, Ссылка = Неопределено) Экспорт
    Текст = СокрЛП(Значение);
    Если Текст = "" ИЛИ НЕ КатегорияВключена(К, Кат) Тогда
        Возврат Значение;
    КонецЕсли;
    КлючКэша = Кат + "|" + Текст;
    Готовая = К.Кэш.Получить(КлючКэша);
    Если Готовая <> Неопределено Тогда
        Возврат Готовая;
    КонецЕсли;
    Длина = 6;
    Пока Истина Цикл
        Код = Лев(ХешСтроки(К.Соль + "|" + Кат + "|" + Текст), Длина);
        Символ = Лев(Код, 1);
        Шард = ШардМеток(К, Символ);
        ТекстМетки = "[" + Кат + "-" + Код + "]";
        Запись = Шард.Получить(ТекстМетки);
        Если Запись = Неопределено ИЛИ Запись.v = Текст Тогда
            Если Запись = Неопределено ИЛИ (Ссылка <> Неопределено И Запись.r = Неопределено) Тогда
                Запись = Новый Структура("v, r", Текст, Ссылка);
                Шард.Вставить(ТекстМетки, Запись);
                Новые = К.Новые.Получить(Символ);
                Если Новые = Неопределено Тогда
                    Новые = Новый Соответствие;
                    К.Новые.Вставить(Символ, Новые);
                КонецЕсли;
                Новые.Вставить(ТекстМетки, Запись);
            КонецЕсли;
            Прервать;
        КонецЕсли;
        Длина = Длина + 2;   // другое значение с той же меткой — метка длиннее
        Если Длина > 64 Тогда
            Возврат "[" + Кат + "-?]";
        КонецЕсли;
    КонецЦикла;
    К.Кэш.Вставить(КлючКэша, ТекстМетки);
    Возврат ТекстМетки;
КонецФункции

// Новые метки — в хранилище. Перечитываем шард перед записью: параллельный запрос мог
// добавить свои метки, затирать их нельзя.
Процедура СохранитьМетки(К) Экспорт
    Для Каждого КЗ Из К.Новые Цикл
        Свежий = ПрочитатьНастройкуОбезличивания("Метки_" + КЗ.Ключ);
        Если ТипЗнч(Свежий) <> Тип("Соответствие") Тогда
            Свежий = Новый Соответствие;
        КонецЕсли;
        Для Каждого Новая Из КЗ.Значение Цикл
            Свежий.Вставить(Новая.Ключ, Новая.Значение);
        КонецЦикла;
        ЗаписатьНастройкуОбезличивания("Метки_" + КЗ.Ключ, Свежий);
    КонецЦикла;
    К.Новые = Новый Соответствие;
КонецПроцедуры

Функция ЭтоКодМетки(Код)
    Если СтрДлина(Код) < 6 Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Н = 1 По СтрДлина(Код) Цикл
        Если СтрНайти("0123456789ABCDEF", Сред(Код, Н, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция НайтиМетку(К, Кандидат)
    Если Лев(Кандидат, 1) <> "[" ИЛИ Прав(Кандидат, 1) <> "]" Тогда
        Возврат Неопределено;
    КонецЕсли;
    Внутри = Сред(Кандидат, 2, СтрДлина(Кандидат) - 2);
    Поз = СтрНайти(Внутри, "-");
    Если Поз < 2 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Код = Сред(Внутри, Поз + 1);
    Если НЕ ЭтоКодМетки(Код) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат ШардМеток(К, Лев(Код, 1)).Получить(Кандидат);
КонецФункции

// Метки в тексте → настоящие значения. ДляЗапроса — текст запроса 1С: значение
// вне кавычек оборачивается в кавычки, кавычки внутри значения удваиваются.
Функция ВосстановитьМетки(К, Текст, ДляЗапроса = Ложь) Экспорт
    Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ СтрНайти(Текст, "[") = 0 Тогда
        Возврат Текст;
    КонецЕсли;
    Результат = "";
    Позиция = 1;
    Длина = СтрДлина(Текст);
    Пока Позиция <= Длина Цикл
        Нач = СтрНайти(Текст, "[", , Позиция);
        Если Нач = 0 Тогда
            Результат = Результат + Сред(Текст, Позиция);
            Прервать;
        КонецЕсли;
        Кон = СтрНайти(Текст, "]", , Нач);
        Запись = Неопределено;
        Если Кон > 0 И Кон - Нач <= 80 Тогда
            Кандидат = Сред(Текст, Нач, Кон - Нач + 1);
            Запись = НайтиМетку(К, Кандидат);
        КонецЕсли;
        Если Запись = Неопределено Тогда
            Результат = Результат + Сред(Текст, Позиция, Нач - Позиция + 1);
            Позиция = Нач + 1;
            Продолжить;
        КонецЕсли;
        Значение = Запись.v;
        К.Восстановленные.Вставить(Значение, Кандидат);
        Если ДляЗапроса Тогда
            ВКавычках = (СтрЧислоВхождений(Лев(Текст, Нач - 1), """") % 2 = 1);
            Значение = СтрЗаменить(Значение, """", """""");
            Если НЕ ВКавычках Тогда
                Значение = """" + Значение + """";
            КонецЕсли;
        КонецЕсли;
        Результат = Результат + Сред(Текст, Позиция, Нач - Позиция) + Значение;
        Позиция = Кон + 1;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Параметр запроса: метка ссылки → сама ссылка, метка значения → значение,
// массив — поэлементно.
Функция ВосстановитьПараметр(К, Значение) Экспорт
    Если ТипЗнч(Значение) = Тип("Строка") Тогда
        Запись = НайтиМетку(К, СокрЛП(Значение));
        Если Запись <> Неопределено Тогда
            К.Восстановленные.Вставить(Запись.v, СокрЛП(Значение));
            Возврат ?(Запись.r <> Неопределено, Запись.r, Запись.v);
        КонецЕсли;
        Возврат ВосстановитьМетки(К, Значение);
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
        Восстановленный = Новый Массив;
        Для Каждого Элемент Из Значение Цикл
            Восстановленный.Добавить(ВосстановитьПараметр(К, Элемент));
        КонецЦикла;
        Возврат Восстановленный;
    КонецЕсли;
    Возврат Значение;
КонецФункции

// Текст ошибки платформы может процитировать восстановленное значение — прячем обратно.
Функция ОбезличитьТекстОшибки(К, Текст) Экспорт
    Результат = Текст;
    Для Каждого КЗ Из К.Восстановленные Цикл
        Если СтрДлина(КЗ.Ключ) >= 3 Тогда
            Результат = СтрЗаменить(Результат, КЗ.Ключ, КЗ.Значение);
        КонецЕсли;
    КонецЦикла;
    Если К.Включено Тогда
        Результат = ОбезличитьШаблоны(К, Результат);
    КонецЕсли;
    Возврат Результат;
КонецФункции

// ── Шаблоны: e-mail, IBAN, ИИН/БИН, телефоны, карты в любом тексте ──

Функция ЭтоЦифра(С)
    Возврат С <> "" И СтрНайти("0123456789", С) > 0;
КонецФункции

Функция ЭтоЛатиница(С)
    Возврат С <> "" И СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", С) > 0;
КонецФункции

Функция ОбезличитьШаблоны(К, Текст) Экспорт
    Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ Текст = "" ИЛИ НЕ К.Включено Тогда
        Возврат Текст;
    КонецЕсли;
    Результат = Текст;
    Если К.Шаблоны.Получить("EMAIL") = Истина И СтрНайти(Результат, "@") > 0 Тогда
        Результат = ЗаменитьПочту(К, Результат);
    КонецЕсли;
    Если К.Шаблоны.Получить("СЧЕТ") = Истина Тогда
        Результат = ЗаменитьIBAN(К, Результат);
    КонецЕсли;
    Результат = ЗаменитьЧисла(К, Результат);
    Возврат Результат;
КонецФункции

Функция ЗаменитьПочту(К, Текст)
    ЛокальныеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._%+-";
    СимволыДомена = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-";
    Результат = "";
    Позиция = 1;
    Пока Позиция <= СтрДлина(Текст) Цикл
        Собака = СтрНайти(Текст, "@", , Позиция);
        Если Собака = 0 Тогда
            Прервать;
        КонецЕсли;
        Лево = Собака;
        Пока Лево > Позиция И СтрНайти(ЛокальныеСимволы, Сред(Текст, Лево - 1, 1)) > 0 Цикл
            Лево = Лево - 1;
        КонецЦикла;
        Право = Собака;
        Пока Право < СтрДлина(Текст) И СтрНайти(СимволыДомена, Сред(Текст, Право + 1, 1)) > 0 Цикл
            Право = Право + 1;
        КонецЦикла;
        Пока Право > Собака И Сред(Текст, Право, 1) = "." Цикл
            Право = Право - 1;
        КонецЦикла;
        Домен = Сред(Текст, Собака + 1, Право - Собака);
        Если Лево < Собака И СтрНайти(Домен, ".") > 1 Тогда
            Результат = Результат + Сред(Текст, Позиция, Лево - Позиция)
                + Метка(К, "EMAIL", Сред(Текст, Лево, Право - Лево + 1));
        Иначе
            Результат = Результат + Сред(Текст, Позиция, Право - Позиция + 1);
        КонецЕсли;
        Позиция = Право + 1;
    КонецЦикла;
    Возврат Результат + Сред(Текст, Позиция);
КонецФункции

// IBAN: две латинские буквы, две цифры, затем 12–30 латинских букв и цифр (KZ — 20 знаков).
Функция ЗаменитьIBAN(К, Текст)
    Результат = "";
    Позиция = 1;
    Н = 1;
    Длина = СтрДлина(Текст);
    Пока Н <= Длина - 15 Цикл
        Если ЭтоЛатиница(Сред(Текст, Н, 1)) И ЭтоЛатиница(Сред(Текст, Н + 1, 1))
            И ЭтоЦифра(Сред(Текст, Н + 2, 1)) И ЭтоЦифра(Сред(Текст, Н + 3, 1))
            И (Н = 1 ИЛИ НЕ (ЭтоЛатиница(Сред(Текст, Н - 1, 1)) ИЛИ ЭтоЦифра(Сред(Текст, Н - 1, 1)))) Тогда
            Конец = Н + 3;
            Пока Конец < Длина И (ЭтоЛатиница(Сред(Текст, Конец + 1, 1)) ИЛИ ЭтоЦифра(Сред(Текст, Конец + 1, 1))) Цикл
                Конец = Конец + 1;
            КонецЦикла;
            ДлинаНомера = Конец - Н + 1;
            Если ДлинаНомера >= 16 И ДлинаНомера <= 34 Тогда
                Результат = Результат + Сред(Текст, Позиция, Н - Позиция)
                    + Метка(К, "СЧЕТ", ВРег(Сред(Текст, Н, ДлинаНомера)));
                Позиция = Конец + 1;
                Н = Конец + 1;
                Продолжить;
            КонецЕсли;
        КонецЕсли;
        Н = Н + 1;
    КонецЦикла;
    Возврат Результат + Сред(Текст, Позиция);
КонецФункции

// Категория числа по его виду: 12 цифр подряд — ИИН/БИН, 16 — карта, 20 — счёт,
// 11 цифр с 7/8 в начале или с «+» — телефон.
Функция КатегорияЧисла(К, Фрагмент)
    Цифры = "";
    ТолькоЦифры = Истина;
    Для Н = 1 По СтрДлина(Фрагмент) Цикл
        С = Сред(Фрагмент, Н, 1);
        Если ЭтоЦифра(С) Тогда
            Цифры = Цифры + С;
        Иначе
            ТолькоЦифры = Ложь;
        КонецЕсли;
    КонецЦикла;
    Количество = СтрДлина(Цифры);
    Если Количество = 12 И ТолькоЦифры И К.Шаблоны.Получить("ИИН") = Истина Тогда
        Возврат "ИИН";
    ИначеЕсли Количество = 16 И К.Шаблоны.Получить("КАРТА") = Истина И СтрНайти(Фрагмент, "(") = 0 Тогда
        Возврат "КАРТА";
    ИначеЕсли Количество = 20 И ТолькоЦифры И К.Шаблоны.Получить("СЧЕТ") = Истина Тогда
        Возврат "СЧЕТ";
    ИначеЕсли Количество = 11 И К.Шаблоны.Получить("ТЕЛ") = Истина
        И (Лев(СокрЛП(Фрагмент), 1) = "+" ИЛИ Лев(Цифры, 1) = "7" ИЛИ Лев(Цифры, 1) = "8") Тогда
        Возврат "ТЕЛ";
    ИначеЕсли Количество = 10 И К.Шаблоны.Получить("ТЕЛ") = Истина И НЕ ТолькоЦифры
        И (Лев(Цифры, 1) = "7" ИЛИ Лев(СокрЛП(Фрагмент), 1) = "(") Тогда
        Возврат "ТЕЛ";
    КонецЕсли;
    Возврат "";
КонецФункции

Функция ЗаменитьЧисла(К, Текст)
    Разделители = " -()+";
    Результат = "";
    Позиция = 1;
    Н = 1;
    Длина = СтрДлина(Текст);
    Пока Н <= Длина Цикл
        С = Сред(Текст, Н, 1);
        Начало = (ЭтоЦифра(С) ИЛИ ((С = "+" ИЛИ С = "(") И ЭтоЦифра(Сред(Текст, Н + 1, 1))))
            И (Н = 1 ИЛИ НЕ (ЭтоЦифра(Сред(Текст, Н - 1, 1)) ИЛИ ЭтоЛатиница(Сред(Текст, Н - 1, 1))));
        Если НЕ Начало Тогда
            Н = Н + 1;
            Продолжить;
        КонецЕсли;
        Конец = Н;
        Пока Конец < Длина И (ЭтоЦифра(Сред(Текст, Конец + 1, 1)) ИЛИ СтрНайти(Разделители, Сред(Текст, Конец + 1, 1)) > 0) Цикл
            Конец = Конец + 1;
        КонецЦикла;
        Пока Конец > Н И НЕ ЭтоЦифра(Сред(Текст, Конец, 1)) Цикл
            Конец = Конец - 1;
        КонецЦикла;
        Если Конец < Длина И ЭтоЛатиница(Сред(Текст, Конец + 1, 1)) Тогда
            Н = Конец + 1;       // часть артикула или кода с буквами — не трогаем
            Продолжить;
        КонецЕсли;
        Фрагмент = Сред(Текст, Н, Конец - Н + 1);
        Кат = КатегорияЧисла(К, Фрагмент);
        Если Кат <> "" Тогда
            Результат = Результат + Сред(Текст, Позиция, Н - Позиция) + Метка(К, Кат, Фрагмент);
        Иначе
            // Несколько чисел через пробел («ИИН 123… 87011234567») — каждое отдельно.
            Части = СтрРазделить(Фрагмент, " ", Ложь);
            Собрано = "";
            Для Каждого Часть Из Части Цикл
                КатЧасти = КатегорияЧисла(К, Часть);
                Собрано = Собрано + ?(Собрано = "", "", " ") + ?(КатЧасти = "", Часть, Метка(К, КатЧасти, Часть));
            КонецЦикла;
            Если Части.Количество() > 1 И Собрано <> СтрСоединить(Части, " ") Тогда
                Результат = Результат + Сред(Текст, Позиция, Н - Позиция) + Собрано;
            Иначе
                Результат = Результат + Сред(Текст, Позиция, Конец - Позиция + 1);
            КонецЕсли;
        КонецЕсли;
        Позиция = Конец + 1;
        Н = Конец + 1;
    КонецЦикла;
    Возврат Результат + Сред(Текст, Позиция);
КонецФункции

// ── Значения из базы ──

Функция ОбезличитьСсылку(К, Ссылка) Экспорт
    Представление = Строка(Ссылка);
    Если Представление = "" Тогда
        Возврат "";
    КонецЕсли;
    МД = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
    Если МД = Неопределено Тогда
        Возврат ОбезличитьШаблоны(К, Представление);
    КонецЕсли;
    ПолноеИмя = МД.ПолноеИмя();
    Вид = Лев(ПолноеИмя, СтрНайти(ПолноеИмя, ".") - 1);
    Если Вид <> "Справочник" И Вид <> "Документ" Тогда
        Возврат ОбезличитьШаблоны(К, Представление);   // перечисления, планы счетов — не персональные данные
    КонецЕсли;
    Если Вид = "Документ" Тогда
        // «Счёт на оплату покупателю» — документ, а не покупатель: у документа прячется номер.
        Кат = ?(КатегорияВключена(К, "ДОК"), "ДОК", "");
    Иначе
        Кат = КатегорияПоПравилам(К, К.Правила.tables, ПолноеИмя);
    КонецЕсли;
    Если Кат = "" Тогда
        Возврат ОбезличитьШаблоны(К, Представление);
    КонецЕсли;
    Если Вид = "Документ" Тогда
        // «Поступление ТМЗ и услуг БКТДЛ000001 от 01.01.2025 0:00:00» → прячем только номер.
        Синоним = "";
        Попытка
            Синоним = МД.ПредставлениеОбъекта;
        Исключение
        КонецПопытки;
        Если НЕ ЗначениеЗаполнено(Синоним) Тогда
            Синоним = МД.Синоним;
        КонецЕсли;
        ПозОт = СтрНайти(Представление, " от ");
        Если ЗначениеЗаполнено(Синоним) И Лев(Представление, СтрДлина(Синоним)) = Синоним И ПозОт > СтрДлина(Синоним) Тогда
            Номер = СокрЛП(Сред(Представление, СтрДлина(Синоним) + 1, ПозОт - СтрДлина(Синоним) - 1));
            Возврат Синоним + " " + Метка(К, "ДОК", Номер) + Сред(Представление, ПозОт);
        КонецЕсли;
    КонецЕсли;
    Возврат Метка(К, Кат, Представление, Ссылка);
КонецФункции

Функция ЭтоСсылкаБазы(Значение) Экспорт
    Если Значение = Неопределено ИЛИ Значение = NULL Тогда
        Возврат Ложь;
    КонецЕсли;
    Т = ТипЗнч(Значение);
    Если Т = Тип("Строка") ИЛИ Т = Тип("Число") ИЛИ Т = Тип("Дата") ИЛИ Т = Тип("Булево") Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Метаданные.НайтиПоТипу(Т) <> Неопределено;
КонецФункции

// Значение колонки для JSON. Кат — категория колонки: «-» — не трогать,
// "" — только шаблоны, иначе — всё значение меткой.
Функция ОбезличитьЗначение(К, Значение, Кат) Экспорт
    Если НЕ К.Включено ИЛИ Кат = "-" Тогда
        Возврат ЗначениеДляJSON(Значение);
    КонецЕсли;
    Если Значение = Неопределено ИЛИ Значение = NULL Тогда
        Возврат "";
    КонецЕсли;
    Т = ТипЗнч(Значение);
    Если Т = Тип("Число") ИЛИ Т = Тип("Булево") ИЛИ Т = Тип("Дата") Тогда
        Возврат ЗначениеДляJSON(Значение);
    КонецЕсли;
    Если ЭтоСсылкаБазы(Значение) Тогда
        Если ЗначениеЗаполнено(Кат) Тогда
            Возврат Метка(К, Кат, Строка(Значение), Значение);
        КонецЕсли;
        Возврат ОбезличитьСсылку(К, Значение);
    КонецЕсли;
    Текст = Строка(Значение);
    Если ЗначениеЗаполнено(Кат) Тогда
        Возврат Метка(К, Кат, Текст);
    КонецЕсли;
    Возврат ОбезличитьШаблоны(К, Текст);
КонецФункции

// ── Категории колонок запроса: по псевдониму и по источнику поля (схема запроса) ──

Функция КатегорияПути(К, Сегменты, Источники)
    // Сегменты: «Т.Контрагент.ИИН» → [Т, Контрагент, ИИН]. Источники: псевдоним → имя таблицы
    // или Соответствие колонок временной таблицы / вложенного запроса.
    Поле = Сегменты[Сегменты.ВГраница()];
    Если ПолеНеТрогать(К, Поле) Тогда
        Возврат "-";
    КонецЕсли;
    Источник = Источники.Получить(НРег(Сегменты[0]));
    Если ТипЗнч(Источник) = Тип("Соответствие") И Сегменты.Количество() = 2 Тогда
        Кат = Источник.Получить(НРег(Поле));
        Возврат ?(Кат = Неопределено, "", Кат);
    КонецЕсли;
    Кат = КатегорияПоПравилам(К, К.Правила.fields, Поле);
    Если Кат <> "" Тогда
        Возврат Кат;
    КонецЕсли;
    // Таблицы, где скрывается всё (контактная информация: адрес по частям в Поле1…Поле10).
    // Вид и Тип — справочные значения, Объект — ссылка (её метку даёт её собственный тип).
    Если Сегменты.Количество() = 2 И ТипЗнч(Источник) = Тип("Строка") И НРег(Поле) <> "вид" И НРег(Поле) <> "тип" И НРег(Поле) <> "объект" Тогда
        Кат = КатегорияПоПравилам(К, К.Правила.tables_all, Источник);
        Если Кат <> "" Тогда
            Возврат Кат;
        КонецЕсли;
    КонецЕсли;
    Если ЭтоПолеНаименования(Поле) Тогда
        // Чьё наименование: ближайший сегмент слева, а у первого — таблица источника.
        Для Н = 2 По Сегменты.Количество() Цикл
            Индекс = Сегменты.Количество() - Н;
            Контекст = Сегменты[Индекс];
            Если Индекс = 0 И ТипЗнч(Источник) = Тип("Строка") Тогда
                Контекст = Источник;
            КонецЕсли;
            Кат = КатегорияПоПравилам(К, К.Правила.tables, Контекст);
            Если Кат <> "" Тогда
                Возврат Кат;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Возврат "";
КонецФункции

Функция КатегорияВыражения(К, ТекстВыражения, Источники)
    // Все «пути» в выражении: ПОДСТРОКА(Контрагенты.ИИН, 1, 6) → [Контрагенты, ИИН].
    Представление = СтрНайти(ВРег(ТекстВыражения), "ПРЕДСТАВЛЕНИЕ") > 0 ИЛИ СтрНайти(ВРег(ТекстВыражения), "PRESENTATION") > 0;
    Путь = "";
    Пути = Новый Массив;
    Текст = ТекстВыражения + " ";
    ВСтроке = Ложь;
    Для Н = 1 По СтрДлина(Текст) Цикл
        С = Сред(Текст, Н, 1);
        Если С = """" Тогда
            ВСтроке = НЕ ВСтроке;
        КонецЕсли;
        Если НЕ ВСтроке И (С = "." ИЛИ С = "_" ИЛИ ЭтоЦифра(С) ИЛИ ЭтоЛатиница(С) ИЛИ (ВРег(С) <> НРег(С))) Тогда
            Путь = Путь + С;
        Иначе
            Если Путь <> "" И НЕ ЭтоЦифра(Лев(Путь, 1)) Тогда
                Пути.Добавить(Путь);
            КонецЕсли;
            Путь = "";
        КонецЕсли;
    КонецЦикла;
    Для Каждого П Из Пути Цикл
        Сегменты = СтрРазделить(П, ".", Ложь);
        Если Сегменты.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        Кат = КатегорияПути(К, Сегменты, Источники);
        Если Кат = "" И Представление Тогда
            Для Каждого Сегмент Из Сегменты Цикл
                Кат = КатегорияПоПравилам(К, К.Правила.tables, Сегмент);
                Если Кат <> "" Тогда
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если Кат <> "" Тогда
            Возврат Кат;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция КатегорииЗапросаСхемы(К, ЗапросСхемы, ВременныеТаблицы)
    // Соответствие: псевдоним колонки (нижний регистр) → категория.
    Результат = Новый Соответствие;
    Колонки = ЗапросСхемы.Колонки;
    Для ИндексОператора = 0 По ЗапросСхемы.Операторы.Количество() - 1 Цикл
        Оператор = ЗапросСхемы.Операторы[ИндексОператора];
        Источники = Новый Соответствие;
        Для Каждого ИсточникСхемы Из Оператор.Источники Цикл
            Таблица = ИсточникСхемы.Источник;
            Псевдоним = НРег(Таблица.Псевдоним);
            Если ТипЗнч(Таблица) = Тип("ТаблицаСхемыЗапроса") Тогда
                // Временная таблица этого же пакета (ПОМЕСТИТЬ) видна здесь как обычная таблица.
                Колонки_ВТ = ВременныеТаблицы.Получить(НРег(Таблица.ИмяТаблицы));
                Источники.Вставить(Псевдоним, ?(Колонки_ВТ = Неопределено, Таблица.ИмяТаблицы, Колонки_ВТ));
            ИначеЕсли ТипЗнч(Таблица) = Тип("ВременнаяТаблицаСхемыЗапроса") Тогда
                Колонки_ВТ = ВременныеТаблицы.Получить(НРег(Таблица.ИмяТаблицы));
                Источники.Вставить(Псевдоним, ?(Колонки_ВТ = Неопределено, Новый Соответствие, Колонки_ВТ));
            ИначеЕсли ТипЗнч(Таблица) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
                Источники.Вставить(Псевдоним, КатегорииЗапросаСхемы(К, Таблица.Запрос, ВременныеТаблицы));
            КонецЕсли;
        КонецЦикла;
        Для Каждого Колонка Из Колонки Цикл
            Ключ = НРег(Колонка.Псевдоним);
            Если Результат.Получить(Ключ) <> Неопределено И Результат.Получить(Ключ) <> "" Тогда
                Продолжить;
            КонецЕсли;
            Кат = "";
            Поле = Колонка.Поля[ИндексОператора];
            Если Поле <> Неопределено Тогда
                Кат = КатегорияВыражения(К, Строка(Поле), Источники);
            КонецЕсли;
            Результат.Вставить(Ключ, Кат);
        КонецЦикла;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция КатегорииКолонок(К, ТекстЗапроса, РезультатЗапроса) Экспорт
    Категории = Новый Соответствие;
    ИзСхемы = Новый Соответствие;
    Попытка
        Схема = Новый СхемаЗапроса;
        Схема.УстановитьТекстЗапроса(ТекстЗапроса);
        ВременныеТаблицы = Новый Соответствие;
        Последний = Неопределено;
        Для Каждого ЗапросПакета Из Схема.ПакетЗапросов Цикл
            Если ТипЗнч(ЗапросПакета) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
                Продолжить;
            КонецЕсли;
            КолонкиЗапроса = КатегорииЗапросаСхемы(К, ЗапросПакета, ВременныеТаблицы);
            Если ЗначениеЗаполнено(ЗапросПакета.ТаблицаДляПомещения) Тогда
                ВременныеТаблицы.Вставить(НРег(ЗапросПакета.ТаблицаДляПомещения), КолонкиЗапроса);
            Иначе
                Последний = КолонкиЗапроса;
            КонецЕсли;
        КонецЦикла;
        Если Последний <> Неопределено Тогда
            ИзСхемы = Последний;
        КонецЕсли;
    Исключение
        // Схему не разобрать — остаются псевдонимы колонок, типы значений и шаблоны.
    КонецПопытки;
    Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
        Если ПолеНеТрогать(К, Колонка.Имя) Тогда
            Категории.Вставить(Колонка.Имя, "-");
            Продолжить;
        КонецЕсли;
        Кат = ИзСхемы.Получить(НРег(Колонка.Имя));
        Если Кат = Неопределено ИЛИ Кат = "" Тогда
            Кат = КатегорияПоПравилам(К, К.Правила.fields, Колонка.Имя);
        КонецЕсли;
        Категории.Вставить(Колонка.Имя, Кат);
    КонецЦикла;
    Возврат Категории;
КонецФункции

// ── Состояние, ключ моста, правила ──

Функция СостояниеОбезличивания() Экспорт
    К = НовыйКонтекстОбезличивания();
    Результат = Новый Структура;
    Результат.Вставить("version", "0.5.0");
    Результат.Вставить("enabled", К.Включено);
    Результат.Вставить("paired", ЗначениеЗаполнено(ПрочитатьНастройкуОбезличивания("КлючМоста")));
    Ревизия = ПрочитатьНастройкуОбезличивания("РевизияПравил");
    Результат.Вставить("rules_revision", ?(ТипЗнч(Ревизия) = Тип("Строка"), Ревизия, ""));
    Результат.Вставить("categories", К.Правила.categories);
    Возврат Результат;
КонецФункции

Функция КлючМостаВерен(Ключ) Экспорт
    Хеш = ПрочитатьНастройкуОбезличивания("КлючМоста");
    Возврат ТипЗнч(Хеш) = Тип("Строка") И ЗначениеЗаполнено(Хеш) И ТипЗнч(Ключ) = Тип("Строка")
        И ХешСтроки(Ключ) = Хеш;
КонецФункции

